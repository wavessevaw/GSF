// afmf-linux: frame interpolation from colour + FidelityFX optical flow.
//
// For every output pixel y the block motion v (prev = cur + v, in pixels) says where the content
// at y sits in each real frame at the midpoint: cur(y - v/2) and prev(y + v/2). Both are fetched
// with bilinear filtering and averaged. When the scene change detector fired, or the motion is
// beyond what the flow can track, the pixel falls back to the configured fast-motion response:
// repeat the previous frame or blend the two without motion.
//
// Compiled once per output format: AFMF_OUT_FORMAT in {rgba8, rgb10_a2, rgba16f}; AFMF_SWAP_RB=1
// writes .bgra so a raw copy into a B8G8R8A8 swapchain image lands in the right channels.
// AFMF_OUT_FORMAT_NONE=1 leaves the storage image unqualified (needs the device feature
// shaderStorageImageWriteWithoutFormat): for writing straight into a B8G8R8A8 swapchain image.

#version 450
#extension GL_EXT_samplerless_texture_functions : require

#ifndef AFMF_BATCHED
#define AFMF_BATCHED 0
#endif

#ifndef AFMF_OUT_FORMAT
#define AFMF_OUT_FORMAT rgba8
#endif
#ifndef AFMF_OUT_FORMAT_NONE
#define AFMF_OUT_FORMAT_NONE 0
#endif
#ifndef AFMF_SWAP_RB
#define AFMF_SWAP_RB 0
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_prev;
layout(set = 0, binding = 1) uniform sampler2D u_cur;
layout(set = 0, binding = 2) uniform itexture2D u_flow;      // rg16i, one texel per 8x8 block
layout(set = 0, binding = 3, r32ui) uniform uimage2D u_scd;  // FidelityFX SCD output, 3 slots
#if AFMF_OUT_FORMAT_NONE
layout(set = 0, binding = 4) writeonly uniform image2D u_out;
#else
layout(set = 0, binding = 4, AFMF_OUT_FORMAT) uniform image2D u_out;
#endif

#if AFMF_BATCHED
#if AFMF_OUT_FORMAT_NONE
layout(set = 0, binding = 5) writeonly uniform image2D u_out2;
layout(set = 0, binding = 6) writeonly uniform image2D u_out3;
#else
layout(set = 0, binding = 5, AFMF_OUT_FORMAT) uniform image2D u_out2;
layout(set = 0, binding = 6, AFMF_OUT_FORMAT) uniform image2D u_out3;
#endif
#endif

layout(push_constant) uniform Params {
    ivec2 size;          // output size in pixels
    int block;           // optical flow block size (8), in flow-resolution pixels
    int fallback;        // 0 repeat previous frame, 1 blend without motion
    float max_motion;    // |v| above which the flow is not trusted, in output pixels
    float flow_scale;    // output pixels per flow-resolution pixel (1 or 2)
    float hud_threshold; // a pixel equal in both frames within this, on a moving block, is HUD: kept as is (0 = off)
    int warp_sampling;   // 0 = bilinear 4 vector fetches, 1 = nearest 1 fetch; cheap, edge artifacts
    float phase; // temporal position in [0,1] between previous and current
#if AFMF_BATCHED
    float phase2;
    float phase3;
    int count;
#endif
} p;

const int SCD_SCENE_CHANGE_SLOT = 0;
const int SCD_HISTORY_BITS_SLOT = 1;

// Flow at pixel y, bilinearly interpolated between the four nearest block centres so the field
// has no 8-pixel steps. Across a motion edge the mix is wrong for both sides, but snapping to
// the nearest block instead cuts the silhouette into 16-pixel steps, which is worse: the
// disagreement of the two warps catches that case below.
vec2 flow_at(vec2 y)
{
    vec2 b = y / (float(p.block) * p.flow_scale) - 0.5;
    ivec2 b0 = ivec2(floor(b));
    vec2 f = b - vec2(b0);
    ivec2 last = textureSize(u_flow, 0) - 1;
    if (p.warp_sampling != 0) {
        // Budget-first reconstruction: nearest block saves THREE integer
        // flow reads and bilinear interpolation per full-resolution pixel.
        // This is an intentional coarse-motion trade-off, not a substitute
        // for the FidelityFX Optical Flow generator itself.
        ivec2 nearest = clamp(ivec2(floor(b + vec2(0.5))), ivec2(0), last);
        return vec2(texelFetch(u_flow, nearest, 0).xy) * p.flow_scale;
    }
    ivec2 b1 = min(b0 + 1, last);
    b0 = max(b0, ivec2(0));
    vec2 v00 = vec2(texelFetch(u_flow, ivec2(b0.x, b0.y), 0).xy);
    vec2 v10 = vec2(texelFetch(u_flow, ivec2(b1.x, b0.y), 0).xy);
    vec2 v01 = vec2(texelFetch(u_flow, ivec2(b0.x, b1.y), 0).xy);
    vec2 v11 = vec2(texelFetch(u_flow, ivec2(b1.x, b1.y), 0).xy);
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y) * p.flow_scale;
}

vec4 reconstruct(ivec2 pix, vec2 v, bool trusted, bool keep_hud, vec4 hud, float phase)
{
    vec2 inv_size = 1.0 / vec2(p.size);
    vec2 y = vec2(pix) + 0.5;
    if (keep_hud) return hud;
    vec4 colour;
    if (trusted) {
        vec4 from_cur = texture(u_cur, (y - (1.0 - phase) * v) * inv_size);
        vec4 from_prev = texture(u_prev, (y + phase * v) * inv_size);
        // The two warps agree where the vector is right and the content exists in both
        // frames; where they disagree (a wrong vector, a silhouette whose blocks carry the
        // background's motion, a background uncovered from behind a passing object) averaging
        // them draws both, a double image, and either warp alone drags the wrong side across
        // the edge. The blend then leans on the current frame's own pixel, unmoved: an object
        // the camera follows stays whole, and a background a fraction out of place is sharp.
        // Measured relative to the local level so HDR values are judged the same way.
        vec3 diff = abs(from_cur.rgb - from_prev.rgb);
        float level = 0.5 * (dot(from_cur.rgb, vec3(1.0 / 3.0)) + dot(from_prev.rgb, vec3(1.0 / 3.0)));
        float disagreement = max(diff.r, max(diff.g, diff.b)) / (level + 0.05);
        float unmoved = smoothstep(0.15, 0.6, disagreement);
        colour = mix(from_prev, from_cur, phase);
        if (unmoved > 0.0) /* exactly zero wherever the warps agree, which is nearly everywhere */
            colour = mix(colour, phase < 0.5 ? texelFetch(u_prev, pix, 0) : texelFetch(u_cur, pix, 0), unmoved);
    } else if (p.fallback == 1) {
        colour = mix(texture(u_prev, y * inv_size), texture(u_cur, y * inv_size), phase);
    } else {
        colour = texture(u_prev, y * inv_size);
    }

    return colour;
}

vec4 output_colour(vec4 colour)
{
#if AFMF_SWAP_RB
    return colour.bgra;
#else
    return colour;
#endif
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= p.size.x || pix.y >= p.size.y) return;
    bool scene_changed = (imageLoad(u_scd, ivec2(SCD_HISTORY_BITS_SLOT, 0)).x & 1u) != 0u;
    // A cut needs no flow reads. All outputs reuse the same field and conservative HUD test.
    vec2 v = scene_changed ? vec2(0) : flow_at(vec2(pix) + 0.5);
    bool trusted = !scene_changed && dot(v, v) <= p.max_motion * p.max_motion;
    bool keep_hud = false;
    vec4 hud = vec4(0);
    if (trusted && p.hud_threshold > 0.0 && dot(v, v) > 0.0) {
        hud = texelFetch(u_cur, pix, 0);
        vec3 diff = abs(hud.rgb - texelFetch(u_prev, pix, 0).rgb);
        keep_hud = max(diff.r, max(diff.g, diff.b)) <= p.hud_threshold;
    }
    imageStore(u_out, pix, output_colour(reconstruct(pix, v, trusted, keep_hud, hud, p.phase)));
#if AFMF_BATCHED
    if (p.count > 1)
        imageStore(u_out2, pix, output_colour(reconstruct(pix, v, trusted, keep_hud, hud, p.phase2)));
    if (p.count > 2)
        imageStore(u_out3, pix, output_colour(reconstruct(pix, v, trusted, keep_hud, hud, p.phase3)));
#endif
}

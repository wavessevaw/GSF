diff --git a/engine/mako-render/tests/fusion_source_transport_tests.cpp b/engine/mako-render/tests/fusion_source_transport_tests.cpp
new file mode 100644
index 0000000..47c4de1
--- /dev/null
+++ b/engine/mako-render/tests/fusion_source_transport_tests.cpp
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "fusion_source_transport.hpp"
+
+using namespace mako;
+using namespace mako::layer;
+
+int main() {
+    constexpr auto rgba = backend::SourceImageLayout::Rgba8;
+    constexpr auto bgra = backend::SourceImageLayout::Bgra8;
+    constexpr auto baseline = backend::SourceImageLayout::Default;
+    static_assert(backend::nativeSourceImageFormat(backend::FrameEncoding::Sdr8, rgba) == VK_FORMAT_R8G8B8A8_UNORM);
+    static_assert(backend::nativeSourceImageFormat(backend::FrameEncoding::Sdr8, bgra) == VK_FORMAT_B8G8R8A8_UNORM);
+    static_assert(!backend::nativeSourceImageFormat(backend::FrameEncoding::Sdr8, baseline));
+    static_assert(!backend::nativeSourceImageFormat(backend::FrameEncoding::SdrHighPrecision, bgra));
+    static_assert(!backend::nativeSourceImageFormat(backend::FrameEncoding::Hdr10Pq, rgba));
+    static_assert(!backend::nativeSourceImageFormat(backend::FrameEncoding::Sdr8, static_cast<backend::SourceImageLayout>(255)));
+    static_assert(backend::nativeSourceImageUsage == (VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT));
+    constexpr SwapchainColorPipeline sdr;
+    constexpr VkExtent2D native{1280, 800};
+    constexpr auto usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    static_assert(nativeFusionSourceCandidate(true, false, sdr, VK_FORMAT_B8G8R8A8_UNORM, usage, native, native) == bgra);
+    static_assert(nativeFusionSourceCandidate(true, false, sdr, VK_FORMAT_R8G8B8A8_UNORM, usage, native, native) == rgba);
+    static_assert(nativeFusionSourceCandidate(false, false, sdr, VK_FORMAT_B8G8R8A8_UNORM, usage, native, native) == baseline);
+    static_assert(nativeFusionSourceCandidate(true, true, sdr, VK_FORMAT_B8G8R8A8_UNORM, usage, native, native) == baseline);
+    static_assert(nativeFusionSourceCandidate(true, false, sdr, VK_FORMAT_B8G8R8A8_UNORM, 0, native, native) == baseline);
+    static_assert(nativeFusionSourceCandidate(true, false, sdr, VK_FORMAT_B8G8R8A8_UNORM, usage, {852, 532}, native) == baseline);
+    static_assert(nativeFusionSourceCandidate(true, false, sdr, VK_FORMAT_B8G8R8A8_UNORM, usage, {}, {}) == baseline);
+    for (const auto format : {VK_FORMAT_R8G8B8A8_SRGB, VK_FORMAT_B8G8R8A8_SRGB,
+            VK_FORMAT_A2B10G10R10_UNORM_PACK32, VK_FORMAT_R16G16B16A16_SFLOAT})
+        if (nativeFusionSourceCandidate(true, false, sdr, format, usage, native, native) != baseline)
+            return 1;
+    for (auto colour : {SwapchainColorPipeline{.generationSupported = false},
+            SwapchainColorPipeline{.hdr = true},
+            SwapchainColorPipeline{.encoding = backend::FrameEncoding::SdrHighPrecision},
+            SwapchainColorPipeline{.encoding = backend::FrameEncoding::Hdr10Pq}})
+        if (nativeFusionSourceCandidate(true, false, colour, VK_FORMAT_B8G8R8A8_UNORM, usage, native, native) != baseline)
+            return 1;
+}

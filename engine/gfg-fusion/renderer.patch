@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "mako.hpp"
+#include <optional>
+#include <vulkan/vulkan_core.h>
+
+namespace mako::backend {
+    /// Native SDR sources are sampled, not written by model storage descriptors.
+    /// Match the exporter's transfer/sampled image contract at the FD boundary.
+    inline constexpr VkImageUsageFlags nativeSourceImageUsage =
+        VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+
+    [[nodiscard]] constexpr std::optional<VkFormat> nativeSourceImageFormat(
+            const FrameEncoding encoding, const SourceImageLayout layout) noexcept {
+        if (encoding != FrameEncoding::Sdr8)
+            return std::nullopt;
+        switch (layout) {
+            case SourceImageLayout::Rgba8: return VK_FORMAT_R8G8B8A8_UNORM;
+            case SourceImageLayout::Bgra8: return VK_FORMAT_B8G8R8A8_UNORM;
+            default: return std::nullopt;
+        }
+    }
+}

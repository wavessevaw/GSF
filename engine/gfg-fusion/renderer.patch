+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "color_pipeline.hpp"
+#include "mako-backend/source_image_layout.hpp"
+
+namespace mako::layer {
+    [[nodiscard]] constexpr backend::SourceImageLayout nativeFusionSourceCandidate(
+            const bool enabled, const bool spatialActive,
+            const SwapchainColorPipeline& colour, const VkFormat applicationFormat,
+            const VkImageUsageFlags applicationUsage,
+            const VkExtent2D source, const VkExtent2D presentation) noexcept {
+        if (!enabled || spatialActive || !colour.generationSupported || colour.hdr ||
+                colour.encoding != backend::FrameEncoding::Sdr8 ||
+                !(applicationUsage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) ||
+                !source.width || !source.height || source.width != presentation.width ||
+                source.height != presentation.height)
+            return backend::SourceImageLayout::Default;
+        switch (applicationFormat) {
+            case VK_FORMAT_R8G8B8A8_UNORM: return backend::SourceImageLayout::Rgba8;
+            case VK_FORMAT_B8G8R8A8_UNORM: return backend::SourceImageLayout::Bgra8;
+            default: return backend::SourceImageLayout::Default;
+        }
+    }
+}

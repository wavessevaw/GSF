+void SpatialScaler::configureDirectFrameGenerationInputs(const vk::Vulkan& vk,
+        const std::span<const std::reference_wrapper<const vk::Image>> inputs) {
+    if (inputs.size() > 64)
+        throw ls::vulkan_error("Frame Fusion input capacity exceeds 64");
+    for (size_t index = 0; index < inputs.size(); ++index) {
+        const auto& image = inputs[index].get();
+        const auto extent = image.getExtent();
+        if (extent.width != this->implementation->sourceSize.width ||
+                extent.height != this->implementation->sourceSize.height ||
+                image.getFormat() != this->implementation->workingFormat ||
+                !(image.getUsage() & VK_IMAGE_USAGE_SAMPLED_BIT))
+            throw ls::vulkan_error("Frame Fusion requires matching sampled input images");
+        for (size_t prior = 0; prior < index; ++prior)
+            if (inputs[prior].get().handle() == image.handle())
+                throw ls::vulkan_error("Frame Fusion rejects duplicate input images");
+    }
+    this->implementation->pipeline->configureDirectInputs(vk, inputs);
+    this->implementation->borrowedApplicationImages.clear();
+    this->implementation->fusionFrames = 0;
+}
+
+void SpatialScaler::configureDirectApplicationInputs(const vk::Vulkan& vk,
+        const std::span<const VkImage> images, const VkExtent2D physicalExtent,
+        const VkFormat format, const VkImageUsageFlags usage) {
+    if (images.empty() || images.size()>64 ||
+            !(usage & VK_IMAGE_USAGE_SAMPLED_BIT) ||
+            (format!=VK_FORMAT_R8G8B8A8_UNORM && format!=VK_FORMAT_B8G8R8A8_UNORM) ||
+            this->implementation->workingFormat!=VK_FORMAT_R8G8B8A8_UNORM ||
+            physicalExtent.width!=this->implementation->presentationSize.width ||
+            physicalExtent.height!=this->implementation->presentationSize.height ||
+            physicalExtent.width<this->implementation->sourceSize.width ||
+            physicalExtent.height<this->implementation->sourceSize.height)
+        throw ls::vulkan_error("Frame Fusion application input is not eligible");
+    std::vector<vk::Image> replacement;
+    std::vector<std::reference_wrapper<const vk::Image>> references;
+    replacement.reserve(images.size());references.reserve(images.size());
+    for(size_t index=0;index<images.size();++index) {
+        if(images[index]==VK_NULL_HANDLE) throw ls::vulkan_error("null application input");
+        for(size_t prior=0;prior<index;++prior)
+            if(images[prior]==images[index]) throw ls::vulkan_error("duplicate application input");
+        replacement.emplace_back(vk,images[index],physicalExtent,format,usage);
+        references.push_back(std::cref(replacement.back()));
+    }
+    this->implementation->pipeline->configureDirectInputs(vk,references);
+    this->implementation->borrowedApplicationImages=std::move(replacement);
+    this->implementation->fusionFrames=0;
+}
+
+void SpatialScaler::clearDirectFrameGenerationInputs() {
+    this->implementation->pipeline->clearDirectInputs();
+    this->implementation->borrowedApplicationImages.clear();
+    this->implementation->fusionFrames = 0;
+}

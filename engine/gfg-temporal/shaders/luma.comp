#version 450
#extension GL_GOOGLE_include_directive : require
// Level 0 luma of the newest real frame (reference: luma).
#include "common.glsl"
#include "luma_store.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, P.size))) return;
    vec3 c = texelFetch(srcB, p, 0).rgb;
    store_luma(0, p, c.r * 0.299 + c.g * 0.587 + c.b * 0.114);
}

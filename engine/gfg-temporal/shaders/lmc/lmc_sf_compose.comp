#version 450
#extension GL_GOOGLE_include_directive : require
// GFG Shared Flow: time-dependent visibility and full-resolution reconstruction.
// Pair fields are reused; visibility at 1/3 and 2/3 is evaluated separately.
#include "lmc_common.glsl"
#include "lmc_store.glsl"
#include "lmc_color.glsl"
#ifndef OUTPUT_FMT
#define OUTPUT_FMT rgba8
#endif
layout(set=1,binding=0,OUTPUT_FMT) uniform writeonly image2D dst;
layout(local_size_x=8,local_size_y=8) in;
vec2 pixel_;float time_,best_;vec3 colour_;int mode_;
vec4 field(int grid,vec2 p) {
    ivec2 nb=lblocks(1),b=clamp(ivec2(floor(p/8.0)),ivec2(0),nb-1);
    int i=b.y*nb.x+b.x;return grid==0?ORB.ob[i]:ORA.oa[i];
}
void consider(vec2 v) {
    vec2 a=pixel_-time_*v*2.0,b=pixel_+(1.0-time_)*v*2.0;
    bool ia=inside(a,P.size.xy),ib=inside(b,P.size.xy);
    float tol=P.tol_px+0.1*length(v);
    float ea=length(field(1,a).xy-v),eb=length(field(0,b).xy-v);
    bool va=ia && ea<tol,vb_=ib && eb<tol;
    if(!va && !vb_)return;
    vec3 ca=ia?full_rgb(0,a):vec3(0.0),cb=ib?full_rgb(1,b):vec3(0.0);
    vec3 d=abs(ca-cb);float residual=(d.r+d.g+d.b)/3.0;
    bool both=va && vb_;
    float score=both?residual+0.002*(ea+eb):0.075+0.002*(va?ea:eb);
    if(score<best_){best_=score;mode_=both?3:(va?1:2);
#ifdef GFG_LINEAR_PQ
        colour_=both?mix(composition_rgb(0,a),composition_rgb(1,b),time_):composition_rgb(va?0:1,va?a:b);
#else
        colour_=both?mix(ca,cb,time_):(va?ca:cb);
#endif
    }
}
// Four consecutive output texels share a single optical-flow/colour sample.
// Static pixels, HUD and cuts are exceptions: copy exact real texels to avoid
// smearing UI or inventing false synthetic content. In moving blocks, source
// reads and expensive warps are amortized across four output stores.
void store_quad(ivec2 base,vec4 packed,bool exact_real) {
    for(int j=0;j<4;++j) {
        ivec2 p=base+ivec2(j&1,j>>1);
        if(any(greaterThanEqual(p,P.size.xy)))continue;
        bool preserve=exact_real || imageLoad(hudCount,p).r>=uint(P.hud_pairs);
        vec4 outc=packed;
        if(preserve) {
            // source textures are already PQ-coded for HDR, hence no extra
            // encode; colour was converted only for generated pixels.
            vec3 original=PC.t<0.5?
                texelFetch(srcA,p,0).rgb:texelFetch(srcB,p,0).rgb;
            outc=vec4(original,1.0);
        }
        imageStore(dst,p,P.pad1!=0?outc.bgra:outc);
    }
}
void main() {
    bool quad=(PC.flags&128)!=0;
    ivec2 p=ivec2(gl_GlobalInvocationID.xy)*(quad?2:1);
    if(any(greaterThanEqual(p,P.size.xy)))return;
    pixel_=vec2(p)+(quad?vec2(0.5):vec2(0.0));time_=PC.t;
    if(quad && G.pal_count!=0u) {
        // Scene cuts copy endpoints exactly, even in the 2x2 mode.
        store_quad(p,vec4(0),true);return;
    }
    if((PC.flags&64)!=0 && (PC.flags&1)==0 && G.pal_count==0u) {
        // Flow Lite: O(1) single-hypothesis full-resolution warp.
        // Coarse A->B flow is computed once per pair, not per output.
        // No RGB patch comparisons, no second reverse optical-flow search,
        // and no per-pixel loops on busy camera turns.
        vec4 f=field(0,pixel_);
        vec2 v=f.xy*2.0; // level-1 flow -> native pixels
        vec2 a=pixel_-time_*v;
        vec2 b=pixel_+(1.0-time_)*v;
        bool ia=inside(a,P.size.xy),ib=inside(b,P.size.xy);
        bool hud=imageLoad(hudCount,p).r>=uint(P.hud_pairs);
        vec3 colour;
        if(hud || (!ia && !ib)) {
            colour=composition_rgb(time_<0.5?0:1,pixel_);
        } else if(ia && ib) {
            // Uncertain flow favours a real source over interpolated ghosts.
            // The confidence comes from the 1/8-scale matched blocks.
            if(f.z>0.13)
                colour=composition_rgb(time_<0.5?0:1,time_<0.5?a:b);
            else
                colour=mix(composition_rgb(0,a),composition_rgb(1,b),time_);
        } else {
            colour=composition_rgb(ia?0:1,ia?a:b);
        }
        vec4 outc=vec4(composition_encode(colour),1.0);
        if(quad) {
            // When nothing moves, avoid even a 2x2 downsample of fine text
            // and geometry. This copies 4 exact source texels, not four warps.
            bool static_block=dot(v,v)<0.0025 && f.z<0.012;
            store_quad(p,outc,static_block);
        } else imageStore(dst,p,P.pad1!=0?outc.bgra:outc);
        return;
    }
    vec3 ca=texelFetch(srcA,p,0).rgb,cb=texelFetch(srcB,p,0).rgb;
    if((PC.flags&1)!=0 || G.pal_count!=0u) {
        vec3 c=(PC.flags&1)!=0 || time_>=0.5?cb:ca;
        imageStore(dst,p,P.pad1!=0?vec4(c.bgr,1):vec4(c,1));return;
    }
    vec2 vb_=field(0,pixel_).xy,va=field(1,pixel_).xy;
    vb_=field(0,pixel_+(1.0-time_)*2.0*vb_).xy;
    va=field(1,pixel_-time_*2.0*va).xy;
    // ECO45: early exact path for static pixels/HUD. The old path first
    // performed expensive source warps and then threw the result away.
    // Preserve its exact chosen pixel and byte packing.
    if(imageLoad(hudCount,p).r>=uint(P.hud_pairs) ||
            (vb_==vec2(0) && va==vec2(0) && ca==cb)) {
        vec4 exact=vec4(time_<0.5?ca:cb,1);
        imageStore(dst,p,P.pad1!=0?exact.bgra:exact);
        return;
    }
    best_=1e30;mode_=0;
#ifdef GFG_LINEAR_PQ
    colour_=mix(composition_rgb(0,pixel_),composition_rgb(1,pixel_),time_);
#else
    colour_=mix(ca,cb,time_);
#endif
    consider(vb_);if(va!=vb_)consider(va);
    // ECO45 bounded fallback: two additional neighbouring surface
    // hypotheses, instead of 18 full-resolution, multi-texture candidates
    // per ambiguous pixel. Use the principal observed motion direction.
    // This deliberately trades edge detail for bounded GPU cost; full
    // quality LMC remains selectable in the Decky diagnostic control.
    if(best_>3.0/255.0 || mode_!=3) {
        vec2 d=dot(vb_,vb_)>=dot(va,va)?vb_:va;
        vec2 step_=abs(d.x)>=abs(d.y)?
            vec2(d.x<0.0?-8.0:8.0,0.0):
            vec2(0.0,d.y<0.0?-8.0:8.0);
        vec2 v0=field(0,pixel_+step_).xy;
        if(v0!=vb_ && v0!=va)consider(v0);
        vec2 v1=field(1,pixel_-step_).xy;
        if(v1!=vb_ && v1!=va && v1!=v0)consider(v1);
    }
#ifdef GFG_LINEAR_PQ
    vec4 outc=vec4(composition_encode(colour_),1);imageStore(dst,p,P.pad1!=0?outc.bgra:outc);
#else
    vec4 outc=vec4(colour_,1);imageStore(dst,p,P.pad1!=0?outc.bgra:outc);
#endif
}

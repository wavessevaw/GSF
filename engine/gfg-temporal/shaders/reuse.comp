#version 450
#extension GL_GOOGLE_include_directive : require
// REUSE / HOLD: copy of the nearest real frame (reference: TemporalEngine._reuse).
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
#ifndef OUTPUT_FMT
#define OUTPUT_FMT rgba8
#endif
layout(set = 1, binding = 0, OUTPUT_FMT) uniform writeonly image2D dst;

void main() {
    uint id = G.list[CLASS_REUSE * uint(tile_count()) + gl_WorkGroupID.x];
    ivec2 tc = ivec2(int(id) % P.tiles.x, int(id) / P.tiles.x);
    for (int by = 0; by < P.tile; by += 8) {
        for (int bx = 0; bx < P.tile; bx += 8) {
            ivec2 p = tc * P.tile + ivec2(bx, by) + ivec2(gl_LocalInvocationID.xy);
            if (any(greaterThanEqual(p, P.size))) continue;
            vec3 c = PC.t < 0.5 ? texelFetch(srcA, p, 0).rgb : texelFetch(srcB, p, 0).rgb;
            imageStore(dst, p, output_color(vec4(c, 1.0)));
        }
    }
}

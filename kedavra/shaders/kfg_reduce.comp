// Half-resolution luma: slot 0 is either colour (full resolution) or the previous
// luma level. One bilinear tap at the shared corner of each 2x2 block is their mean.
// HDR colour (KFG_FLAG_PQ, KFG_FLAG_SCRGB) becomes 0..1 luma like SDR (kfg_hdr_luma).
#version 450
#extension GL_GOOGLE_include_directive : require
#include "kfg_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

#define KFG_FLAG_LUMA_INPUT 4
#define KFG_FLAG_TENT 8

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, u_dstSize)))
		return;
	vec2 corner = vec2(2 * p) + vec2(0.5); // texel space of slot 0, between 4 texels
	float y;
	if ((u_flags & KFG_FLAG_RESAMPLE) != 0) {
		// Colour above the analysis size straight to analysis level 1 (1080p: 2.8 source
		// pixels per luma texel, 4K: 5.7): four bilinear taps spread over the texel's footprint.
		vec2 r = vec2(u_srcSize) / vec2(u_dstSize);
		vec2 c = (vec2(p) + 0.5) * r - 0.5;
		vec2 o = 0.25 * r;
		y = 0.0;
		for (int i = 0; i < 4; i++) {
			vec3 rgb = kfg_tap(0, c + vec2((i & 1) != 0 ? o.x : -o.x, (i & 2) != 0 ? o.y : -o.y), u_srcSize).rgb;
			y += (u_flags & (KFG_FLAG_PQ | KFG_FLAG_SCRGB)) != 0 ? kfg_hdr_luma(rgb, u_flags) : kfg_luma(rgb);
		}
		y *= 0.25;
	} else if ((u_flags & KFG_FLAG_TENT) != 0) {
		// Coarse search levels (3 and 4): a 4x4 box from four bilinear taps.
		// The legacy TENT flag names this wider prefilter; offsets +/-1 give uniform
		// weights, not a [1,3,3,1] tent. Sampling is intentionally unchanged.
		y = 0.25 * (kfg_tap(0, corner + vec2(-1.0, -1.0), u_srcSize).r + kfg_tap(0, corner + vec2(1.0, -1.0), u_srcSize).r +
			    kfg_tap(0, corner + vec2(-1.0, 1.0), u_srcSize).r + kfg_tap(0, corner + vec2(1.0, 1.0), u_srcSize).r);
	} else {
		vec4 c = kfg_tap(0, corner, u_srcSize);
		if ((u_flags & KFG_FLAG_LUMA_INPUT) != 0)
			y = c.r;
		else if ((u_flags & (KFG_FLAG_PQ | KFG_FLAG_SCRGB)) != 0)
			y = kfg_hdr_luma(c.rgb, u_flags);
		else
			y = kfg_luma(c.rgb);
	}
	imageStore(dst, p, vec4(y, 0.0, 0.0, 1.0));
}

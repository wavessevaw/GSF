// SPDX-License-Identifier: GPL-3.0-or-later
// Full-resolution synthesis of one generated frame at phase u_t.
// Slots: 0 = colour A, 1 = colour B, 2 = selected motion (4x4 blocks), 3 = stats.
// Colour is interpolated in the source's stored encoding.
#version 450
#extension GL_GOOGLE_include_directive : require
#include "kfg_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, u_dstSize)))
		return;
	ivec2 size = u_fullSize;
	vec4 stats = texelFetch(s_samplers[3], ivec2(0), 0);
	if (stats.x > 0.5) {
		// Scene cut: never blend two unrelated images.
		vec4 c = u_t < 0.5 ? texelFetch(s_samplers[0], p, 0) : texelFetch(s_samplers[1], p, 0);
		imageStore(dst, p, vec4(c.rgb, 1.0));
		return;
	}
	ivec2 bsize = (size + 3) / 4;
	// Bilinear footprint over the block field; use it only where the four vectors agree.
	vec2 bp = (vec2(p) + 0.5) * 0.25 - 0.5;
	ivec2 b0 = ivec2(floor(bp));
	vec2 fr = bp - vec2(b0);
	vec4 s00 = texelFetch(s_samplers[2], clamp(b0, ivec2(0), bsize - 1), 0);
	vec4 s10 = texelFetch(s_samplers[2], clamp(b0 + ivec2(1, 0), ivec2(0), bsize - 1), 0);
	vec4 s01 = texelFetch(s_samplers[2], clamp(b0 + ivec2(0, 1), ivec2(0), bsize - 1), 0);
	vec4 s11 = texelFetch(s_samplers[2], clamp(b0 + ivec2(1, 1), ivec2(0), bsize - 1), 0);
	vec4 sel;
	float spread = max(max(length(s00.xy - s10.xy), length(s00.xy - s01.xy)), length(s00.xy - s11.xy));
	if (spread < 2.0) {
		sel = mix(mix(s00, s10, fr.x), mix(s01, s11, fr.x), fr.y);
	} else {
		// Motion boundary: choose per pixel among the four neighbouring block motions by
		// photometric agreement of the two sources, preferring the pixel's own block.
		vec4 cand[4] = vec4[4](s00, s10, s01, s11);
		int own = (fr.x < 0.5 ? 0 : 1) + (fr.y < 0.5 ? 0 : 2);
		float best = 1e9;
		sel = cand[own];
		for (int i = 0; i < 4; i++) {
			vec2 v = cand[i].xy;
			vec3 a = kfg_tap(0, vec2(p) - u_t * v, size).rgb;
			vec3 b = kfg_tap(1, vec2(p) + (1.0 - u_t) * v, size).rgb;
			float e = dot(abs(a - b), vec3(1.0)) - (i == own ? 0.02 : 0.0);
			if (e < best) {
				best = e;
				sel = cand[i];
			}
		}
	}
	vec2 v = sel.xy;
	vec2 pa = vec2(p) - u_t * v;
	vec2 pb = vec2(p) + (1.0 - u_t) * v;
	vec4 ca = kfg_tap(0, pa, size);
	vec4 cb = kfg_tap(1, pb, size);
	// Out-of-frame samples: take the other side when only one is inside the image.
	bool ina = all(greaterThanEqual(pa, vec2(0.0))) && all(lessThan(pa, vec2(size)));
	bool inb = all(greaterThanEqual(pb, vec2(0.0))) && all(lessThan(pb, vec2(size)));
	float w_b = sel.z;
	if (ina && !inb)
		w_b = 0.0;
	else if (inb && !ina)
		w_b = 1.0;
	vec3 c = mix(ca.rgb, cb.rgb, w_b);
	if ((u_flags & KFG_FLAG_DEBUG_MARKER) != 0 && p.x < 24 && p.y < 24) {
		// Optical-verification marker: brightness encodes the phase (camera tests only).
		c = vec3(u_t);
	}
	imageStore(dst, p, vec4(c, 1.0));
}
